# =============================================================================
# RoomKit Website - Multi-stage build
# =============================================================================

# Stage 1: Build mkdocs documentation
FROM python:3.12-slim AS docs-builder

WORKDIR /build

# Install mkdocs and dependencies
RUN pip install --no-cache-dir \
    mkdocs>=1.6 \
    mkdocs-material>=9.5 \
    mkdocstrings[python]>=0.27

# Copy source code and docs
COPY src/ src/
COPY docs/ docs/
COPY mkdocs.yml .
COPY pyproject.toml .

# Build documentation
RUN mkdocs build --strict

# Stage 2: Final nginx image
FROM nginx:alpine

# Copy custom nginx config
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml;

    # Cache static assets
    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Serve llms.txt and llms-full.txt at root
    location = /llms.txt {
        default_type text/plain;
    }
    location = /llms-full.txt {
        default_type text/plain;
    }

    # Use X-Forwarded-Proto from reverse proxy for correct redirect scheme
    set $redirect_scheme $scheme;
    if ($http_x_forwarded_proto) {
        set $redirect_scheme $http_x_forwarded_proto;
    }

    # Enforce trailing slash on directories (prevents duplicate URLs)
    # If a URI has no extension and no trailing slash, and a directory exists, redirect
    location ~ ^([^.]*[^/])$ {
        if (-d /usr/share/nginx/html$uri) {
            return 301 $redirect_scheme://$host$uri/;
        }
        # Fall through to try_files for actual files without extensions
        try_files $uri =404;
    }

    # Documentation routes
    location /docs {
        alias /usr/share/nginx/html/docs;
        try_files $uri $uri/ $uri/index.html =404;
    }

    # Health check endpoint (exact match to override regex locations)
    location = /health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # Static site - serve files or 404 (no SPA fallback)
    location / {
        try_files $uri $uri/ =404;
    }

    # Error pages
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
}
EOF

# Copy website files
COPY website/ /usr/share/nginx/html/

# Copy built documentation
COPY --from=docs-builder /build/site /usr/share/nginx/html/docs

# Copy llms.txt and llms-full.txt to root
COPY llms.txt /usr/share/nginx/html/
COPY llms-full.txt /usr/share/nginx/html/

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1
